# AI Chatbot Assistant
VITE_GEMINI_API_KEY=your_gemini_or_openrouter_api_key

# --- Razorpay Payment Gateway (Serverless API) ---
# Obtain from Razorpay Dashboard -> Settings -> API Keys (Test or Live)
RAZORPAY_KEY_ID=rzp_test_or_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# --- Supabase Database ---
# Obtain from Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_anon_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Google Sheets Webhook (Instant Sync) ---
# Deploy via Google Apps Script Web App on your Google Sheet (instructions provided)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/xxxxxxxxxxxx/exec

# Site Base URL
VITE_SITE_URL=https://spectrum10.vercel.app
